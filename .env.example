# Server
PORT=3001
NODE_ENV=development

# Google OAuth2 (Gmail)
# Get these from https://console.cloud.google.com
# Create OAuth 2.0 credentials, set redirect URI to http://localhost:3001/api/auth/gmail/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Database
DB_PATH=./data/dashboard.db

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Feishu sync (npm run sync:feishu) — one-way mirror of a Feishu bitable into the Overview.
# Create a Feishu custom app, add it as a collaborator on the base, then fill these in.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_BITABLE_APP_TOKEN=your_base_app_token_here
FEISHU_VISITS_TABLE_ID=tblxxxxxxxxxxxxxx
# Optional 2nd source — the Gmail-channel outreach table (separate base). Leave blank to skip email.
FEISHU_EMAIL_BASE_TOKEN=
FEISHU_EMAIL_TABLE_ID=
